# Dota 2 Agent — Environment Configuration
# Copy this file to .env and fill in values as needed.
# No keys are required for dry-run mode.

# ---- Optional ----
# The Odds API key (stored for future use; no Dota/esports odds available today)
ODDS_API_KEY=

# Dry-run mode (always true for paper trading)
DRY_RUN=true

