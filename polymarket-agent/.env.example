# Polymarket Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. All values shown are defaults.

# ── Mode ──────────────────────────────────────────────────────────────────────

# Set to false to place real orders on Polymarket. Requires POLY_* credentials below.
DRY_RUN=true

# ── Polymarket credentials (live mode only) ───────────────────────────────────

# Your wallet private key (EOA). Never commit this.
POLY_PRIVATE_KEY=

# Your wallet address. Only needed if using a proxy/funder wallet.
POLY_ADDRESS=

# Chain ID. 137 = Polygon mainnet (default). 80002 = Amoy testnet.
POLY_CHAIN_ID=137

# CLOB API credentials — generate once with: python live_setup.py
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Bankroll & sizing ─────────────────────────────────────────────────────────

# Virtual (or real) bankroll in USD. Kelly sizing is relative to this.
VIRTUAL_BANKROLL=10000

# Maximum stake per bet in USD (hard cap on Kelly output).
MAX_BET_SIZE=250

# Minimum stake per bet in USD (Kelly bets below this are skipped).
MIN_BET_SIZE=10

# Minimum USDC spend for a live CLOB order. CLOB rejects orders below ~$1–5.
MIN_LIVE_ORDER_USDC=2.0

# Maximum USD stake for bets with no edge signal (unguided bets).
MAX_NO_SIGNAL_BET_SIZE=5

# Maximum open exposure as a fraction of bankroll (e.g. 0.80 = 80%).
MAX_OPEN_EXPOSURE_PCT=0.80

# ── Scanning ──────────────────────────────────────────────────────────────────

# Maximum new bets to place per scan cycle.
MAX_BETS_PER_SCAN=5

# Skip markets resolving more than this many days out.
MAX_DAYS_TO_EXPIRY=180

# ── Edge filter ───────────────────────────────────────────────────────────────

# Minimum edge (true_prob - market_prob) required to place a bet.
MIN_EDGE=0.03

# API key for the-odds-api.com (sports markets). Free tier available.
ODDS_API_KEY=

# ── LLM edge signal (Claude) ──────────────────────────────────────────────────

# Anthropic API key. Required for LLM edge signals on non-sports/crypto markets.
ANTHROPIC_API_KEY=

# Set to false to disable LLM edge signals entirely.
LLM_EDGE_ENABLED=true

# Claude model used for edge signals. Haiku is fast and cheap.
LLM_EDGE_MODEL=claude-haiku-4-5-20251001

# ── Risk management ───────────────────────────────────────────────────────────

# Close position if price drops this many percentage points from entry (e.g. 0.20 = 20pp).
STOP_LOSS_PPTS=0.20

# Close position if price rises this many percentage points from entry (e.g. 0.10 = 10pp).
TAKE_PROFIT_PPTS=0.10

# Days before a resolved market can be re-entered.
MARKET_COOLDOWN_DAYS=7

# ── Intervals ─────────────────────────────────────────────────────────────────

# Minutes between market scans.
SCAN_INTERVAL_MINUTES=30

# Minutes between resolution checks.
TRACK_INTERVAL_MINUTES=15
