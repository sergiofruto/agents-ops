# Finance Agent — copy to .env and fill in values

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Monthly income in USD
MONTHLY_INCOME=5500

# House goal target in USD
GOAL_TARGET=100000

# Monthly savings target in USD
MONTHLY_SAVINGS_TARGET=3000

# ARS/USD exchange rate (update manually or auto-fetched)
# Leave blank to auto-fetch from BCRA API
ARS_USD_RATE=

# Web server
WEB_PORT=5006
