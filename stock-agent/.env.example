# Alpha Vantage — news sentiment + fundamentals
ALPHA_VANTAGE_KEY=your_key_here

# Anthropic — LLM synthesis
ANTHROPIC_API_KEY=your_key_here

# Watchlists (comma-separated)
STOCK_WATCHLIST=AAPL,MSFT,NVDA,TSLA,META,AMZN
CRYPTO_WATCHLIST=BTC,ETH,SOL

# Paper trading
VIRTUAL_BANKROLL=10000.0
MAX_POSITION_PCT=0.10
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=0.07
TAKE_PROFIT_PCT=0.20

# Signal thresholds
MIN_CONFIDENCE=0.65
MIN_RULE_SIGNALS=2

# Timing
SCAN_INTERVAL_MINUTES=30
TRACK_INTERVAL_MINUTES=15

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=5005
