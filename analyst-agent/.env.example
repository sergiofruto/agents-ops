# The Analyst — environment variables
# Copy to .env and fill in as needed. All keys are optional.

# Scan intervals (minutes)
INTEL_INTERVAL_MINUTES=60
COSMIC_INTERVAL_MINUTES=360
BRIEF_INTERVAL_MINUTES=120

# Web dashboard port (avoid 5000 on macOS — AirPlay Receiver)
WEB_PORT=5003

# Observer location for cosmic calculations (default: New York)
OBSERVER_LAT=40.7128
OBSERVER_LON=-74.0060
OBSERVER_ELEV=10

# Aspect orb tolerance in degrees (default: 8)
ASPECT_ORB=8.0

# NIST NVD (optional — higher rate limits with key)
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_DAYS_BACK=3

# AlienVault OTX (optional)
# Register at https://otx.alienvault.com
OTX_API_KEY=

# OpenSky Network (optional — anonymous access works but is rate-limited)
# Register at https://opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# aisstream.io — live ship AIS data (optional)
# Register at https://aisstream.io
AIS_API_KEY=

# Shodan (optional — infrastructure intelligence)
# Register at https://shodan.io
SHODAN_API_KEY=
